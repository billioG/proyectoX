# Los scripts de la Raspberry tienen que tener fin de línea de Linux (LF);
# con CRLF de Windows, bash falla con errores como "$'\r': command not found".
*.sh text eol=lf
scripts/ci/*.txt text eol=lf
scripts/ci/*.sql text eol=lf

# Librerias de terceros servidas tal cual (el hash SRI de js/model-viewer.js depende de los bytes exactos): sin conversion de fin de linea en Windows.
vendor/cdn/** -text
